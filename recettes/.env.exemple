# Copie ce fichier sous le nom .env puis remplis les valeurs.

# Clé API Claude (https://console.anthropic.com). Sans clé, l'import garde
# la légende, la transcription et les captures, sans rédiger la fiche.
ANTHROPIC_API_KEY=

# Modèle de transcription locale : tiny, base, small (conseillé), medium.
MODELE_WHISPER=small

# Fichier de cookies au format Netscape, utile pour Instagram. Optionnel.
COOKIES_FICHIER=
